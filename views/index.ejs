<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>互動式簡報投票系統 | Interactive Presentation Voting</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <script>
        // Inject options mapping directly into the window object from backend
        window.displayNames = <%- JSON.stringify(options) %>;
    </script>
</head>
<body>
    <div class="background-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>

    <!-- Admin Login Button -->
    <button id="header-login-btn" class="header-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        <span>管理員登入</span>
    </button>
    
    <div class="container">
        <header>
            <h1 class="gradient-text">今晚您想聽什麼？</h1>
            <p>請選擇您最感興趣的主題，投下神聖的一票！</p>
        </header>

        <main id="app-content">
            <!-- Loading State -->
            <div id="loading" class="state-container">
                <div class="spinner"></div>
                <p>載入中...</p>
            </div>

            <!-- Voting Form -->
            <div id="voting-state" class="state-container hidden">
                <div class="split-buttons-container">
                    <button class="vote-btn red-btn" data-option="red">
                        <div class="btn-content">
                            <span><%= options.red.title %></span>
                            <small><%= options.red.subtitle %></small>
                        </div>
                    </button>
                    <button class="vote-btn green-btn" data-option="green">
                        <div class="btn-content">
                            <span><%= options.green.title %></span>
                            <small><%= options.green.subtitle %></small>
                        </div>
                    </button>
                </div>
                <div id="error-message" class="message error hidden"></div>
            </div>

            <!-- Results Display -->
            <div id="results-state" class="state-container hidden">
                <div class="success-banner">
                    <svg viewBox="0 0 24 24" class="success-icon"><path fill="currentColor" d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2m-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    <h2>感謝您的參與！</h2>
                </div>
                <p class="results-subtitle">目前投票結果 (即時更新)</p>
                <div id="results-container" class="results-list">
                    <!-- Results will be injected here via JS -->
                </div>
                
                <!-- User Only Revote Button -->
                <div id="user-controls" class="hidden" style="margin-top: 1.5rem; text-align: center;">
                    <button id="revote-btn" class="header-btn" style="position: static; margin: 0 auto; display: inline-flex;">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
                        <span>重新投票 (Change Vote)</span>
                    </button>
                </div>
                
                <!-- Admin Only Reset Button -->
                <div id="admin-controls" class="hidden" style="margin-top: 2rem; text-align: center; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem;">
                    <button id="reset-btn" class="danger-btn">
                        <span>重置所有票數 (Admin)</span>
                    </button>
                </div>
            </div>
        </main>
    </div>

    <!-- Login Modal -->
    <div id="login-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <button id="close-modal" class="close-btn">&times;</button>
            <h2>管理員登入</h2>
            <form id="login-form">
                <div class="input-group">
                    <input type="password" id="password-input" class="modern-input" placeholder="請輸入密碼" required>
                </div>
                <button type="submit" id="login-btn" class="primary-btn">
                    <span>登入</span>
                </button>
            </form>
            <div id="login-error" class="message error hidden"></div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
